/* ═══════════════════════════════════════════════════
   Mac OS System 1 (1984) — Monochrome Terminal Theme
   ═══════════════════════════════════════════════════ */

Screen {
    align: center middle;
    background: #a8a8a8;
}

/* ── Window chrome ─────────────────────────────── */

#card {
    width: 64;
    max-width: 95%;
    height: auto;
    border: heavy #000000;
    padding: 0;
    background: #ffffff;
    color: #000000;
}

.title-bar {
    width: 100%;
    background: #000000;
    color: #ffffff;
    text-style: bold;
    height: 1;
    padding: 0 0;
}

.card-body {
    padding: 1 3;
    height: auto;
}

/* ── Typography ────────────────────────────────── */

.section-title {
    color: #000000;
    margin-bottom: 1;
}

.video-heading {
    color: #000000;
    text-style: bold;
    margin-bottom: 1;
}

/* ── Input field ───────────────────────────────── */

#url-input {
    border: tall #000000;
    background: #ffffff;
    color: #000000;
    padding: 0 1;
    height: 3;
}

#url-input:focus {
    border: double #000000;
}

/* ── Finding steps ─────────────────────────────── */

.step-row {
    height: 1;
    margin: 0;
    color: #666666;
}

.step-done {
    color: #000000;
    text-style: bold;
}

.step-active {
    color: #000000;
}

/* ── Quality / episode list ──────────────────────── */

.quality-container {
    margin: 1 0;
    height: auto;
}

#episode-list {
    max-height: 16;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

.quality-item {
    height: 1;
    color: #000000;
    padding: 0 1;
}

.quality-item-selected {
    background: #000000;
    color: #ffffff;
    text-style: bold;
}

/* ── Progress bar ──────────────────────────────── */

.progress-container {
    margin: 1 0;
    height: auto;
}

.progress-bar-text {
    color: #000000;
    text-style: bold;
    margin-bottom: 1;
}

.progress-stats {
    color: #000000;
}

.progress-status {
    color: #000000;
    text-style: bold;
    height: 1;
}

/* ── Result screens ────────────────────────────── */

.success-title {
    color: #000000;
    text-style: bold;
    margin-bottom: 1;
}

.error-title {
    color: #000000;
    text-style: bold reverse;
    padding: 0 1;
    margin-bottom: 1;
}

.error-desc {
    color: #000000;
    margin-bottom: 1;
}

.file-info {
    color: #000000;
    text-style: bold;
    margin-bottom: 1;
}

.folder-info {
    color: #444444;
    margin-bottom: 1;
}

/* ── Footer / navigation ──────────────────────── */

.footer-nav {
    color: #000000;
    margin-top: 1;
}
